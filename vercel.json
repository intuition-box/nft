{
  "buildCommand": "yarn workspace @se-2/nextjs build",
  "outputDirectory": "packages/nextjs/.next",
  "installCommand": "yarn install",
  "framework": "nextjs",
  "functions": {
    "packages/nextjs/**/*.{js,jsx,ts,tsx}": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/packages/nextjs/$1"
    }
  ]
}